# =============================================================================
# micasaestuya-infra — Docker Compose dev environment variables
# Copy this file to .env and adjust values as needed.
# The .env file must be placed in the same directory as docker-compose.yml:
#   micasaestuya-infra/.env
# =============================================================================

# ---------------------------------------------------------------------------
# MongoDB credentials
# Used by the mongo service.
# ---------------------------------------------------------------------------
MONGO_DB_USERNAME=root
MONGO_DB_PASSWORD=example

# Database name created on first init.
MONGO_DB_NAME=micasaestuya-dev

# Full MongoDB connection URI, including database name and authSource.
MONGO_DB_URI=mongodb://root:example@mongo:27017/micasaestuya-dev?authSource=admin

# Used by the api's test suite (separate db, same instance).
MONGO_DB_TEST_URI=mongodb://root:example@mongo:27017/micasaestuya-test-dev?authSource=admin

# ---------------------------------------------------------------------------
# Backend (Express) secrets
# SECRET is used for JWT signing — change this to a strong random string.
# ---------------------------------------------------------------------------
SECRET=change_me_to_a_strong_secret

# ---------------------------------------------------------------------------
# Request rate limit (login, sign-up, publish)
# Leave it on. Set RATE_LIMIT=off only to run e2e tests locally in a row
# without hitting 429; the api ignores it in production.
# ---------------------------------------------------------------------------
RATE_LIMIT=on

# ---------------------------------------------------------------------------
# Cloudflare R2 (listing photos)
# Local uses the DEV bucket and its own token (Object Read & Write, scoped to
# that bucket only), never the production one. Do not commit real values.
# R2_PUBLIC_URL is the public URL of the dev bucket (Settings > Public
# Development URL), without the trailing slash.
# Without these, everything works except photo uploads.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=micasaestuya-photos-dev
R2_PUBLIC_URL=
